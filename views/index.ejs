<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<style>
    
    body {
        font-family: Arial, sans-serif;
        background-color: #ece5dd;
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
    }

    #chat {
        width: 350px;
        height: 500px;
        background: #efeae2;
        border-radius: 10px;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        box-shadow: 0 0 10px rgba(0,0,0,0.2);
    }

    h1 {
        text-align: center;
        background: #075e54;
        color: white;
        margin: 0;
        padding: 10px;
        font-size: 18px;
    }

    /* messages area */
    #chat p {
        max-width: 70%;
        padding: 8px 12px;
        margin: 5px 10px;
        border-radius: 10px;
        font-size: 14px;
        word-wrap: break-word;
    }

    /* my message */
    #chat p[style*="right"] {
        background: #dcf8c6;
        align-self: flex-end;
    }

    /* other message */
    #chat p[style*="left"] {
        background: white;
        align-self: flex-start;
    }

    /* input area */
    #msginput {
        flex: 1;
        padding: 10px;
        border: none;
        outline: none;
    }

    #btn {
        background: #075e54;
        color: white;
        border: none;
        padding: 10px 15px;
        cursor: pointer;
    }

    #btn:hover {
        background: #0b7d6e;
    }

    /* bottom input container */
    #chat input, #chat button {
        border-top: 1px solid #ccc;
    }

    /* input + button wrapper */
    #chat > input,
    #chat > button {
        display: inline-block;
    }


</style>
<body>
    <h1>Chatting app</h1>
    <div id="chat">
      
        <input type="text" placeholder="Enter your message" id="msginput">
        <button id="btn">Send</button>
    </div>

    <script src="/socket.io/socket.io.js"></script>
    <script>
        
   
    const socket = io();
    const msgInput = document.querySelector('#msginput');
    const sendBtn = document.querySelector('#btn');
    const chatBox = document.querySelector('#chat');

    // display msgs
    socket.on('message', (message) => {
        addMessages(message, 'other');
    });

    // button clicked
    sendBtn.addEventListener('click', sendMessages);

    // Enter press
    msgInput.addEventListener('keypress', (e) => {
        if (e.key === "Enter") sendMessages();
    });

    function sendMessages() {
        const message = msgInput.value.trim();
        if (!message) return;

        addMessages(message, "me");

        socket.emit("message", message); 

        msgInput.value = ""; 
    }

    // add msgs to UI
    function addMessages(text, type) {
        const p = document.createElement('p');
        p.textContent = text;

        // optional styling
        p.style.textAlign = type === "me" ? "right" : "left";

        chatBox.appendChild(p);

        // auto scroll
        chatBox.scrollTop = chatBox.scrollHeight;
    }
</script>
   
</body>
</html>